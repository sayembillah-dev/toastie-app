# Single shared env file for the whole monorepo — apps/api and apps/web both
# read this one file (see apps/api/src/app.module.ts's ConfigModule.forRoot
# and apps/web/next.config.ts's dotenv load). Do not add per-app .env files.
# Copy this to `.env` at the repo root and fill in real values — keep the
# actual `.env` out of git.

# --- environment switch ---
# `development` | `production`. Deliberately separate from NODE_ENV, which the
# tooling owns (`next build` and PM2 both force it to `production`). APP_ENV is
# what decides whether infrastructure-backed features are wired up: Redis and
# BullMQ are only connected when this is `production`. Local development never
# talks to Redis. Validated at boot by apps/api/src/config/env.validation.ts —
# a bad value fails startup rather than silently disabling a feature.
APP_ENV=development

# --- apps/web ---
# Where the Next.js rewrite proxy forwards /api/* requests. Note this is read at
# *build* time: Next serialises rewrites into routes-manifest.json, so changing
# it requires a rebuild, not just a restart.
API_URL=http://localhost:4000

# --- apps/api: Postgres ---
# Point this at a Neon / Supabase / local Postgres URL. Prisma reads it via
# `datasource db { url = env("DATABASE_URL") }`.
DATABASE_URL="postgresql://toastly:toastly@localhost:5432/toastly?schema=public"

# Unpooled connection string, used only for `prisma migrate`. On Neon this is
# the same host with `-pooler` removed. Required because `migrate deploy`'s
# advisory lock doesn't survive PgBouncer's transaction-pooling mode — see
# `directUrl` in schema.prisma. Local Postgres has no pooler, so this can be
# the same value as DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://toastly:toastly@localhost:5432/toastly?schema=public"

# --- apps/api: HTTP ---
PORT=4000
# Comma-separated list; the API rejects Origin headers that don't match one.
CORS_ORIGINS=http://localhost:3000

# --- apps/api: JWT ---
# Access token: short TTL because it's stealable via XSS. Refresh token: longer
# TTL, rotated on use, family-tracked so a stolen replay revokes the whole
# lineage.
# There is no JWT_REFRESH_SECRET: refresh tokens are opaque random strings that
# are SHA-hashed into a RefreshToken row, not signed JWTs, so nothing signs them.
# Boot fails if JWT_ACCESS_SECRET is under 16 chars, or is still this
# placeholder while APP_ENV=production.
JWT_ACCESS_SECRET="change-me-in-.env"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- apps/api: Super admin bootstrap ---
# Read by `prisma/seed.ts`. On every `pnpm --filter @toastly/api prisma:seed`
# the seed upserts a User with these credentials + `isSuperAdmin: true`. A
# missing var is a hard error — the seed refuses to run rather than leave the
# environment without an admin. Rotate the password by editing this file and
# re-seeding; the upsert re-hashes on every run.
SUPER_ADMIN_PHONE="+15550000001"
SUPER_ADMIN_PASSWORD="change-me-in-.env-and-make-it-strong"

# --- apps/api: Redis / BullMQ (production only) ---
# Required when APP_ENV=production, ignored otherwise. Background jobs run
# inline in development so no Redis is needed locally — see
# apps/api/src/queue/queue.module.ts.
# REDIS_URL="redis://localhost:6379"

# --- Web Push (apps/api/src/push + apps/web/src/lib/push) ---
# Unset by default — subscribing/unsubscribing works with no keys at all,
# but PushService.send() no-ops until these are set (see push.service.ts).
# Generate a real pair with: pnpm dlx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY and NEXT_PUBLIC_VAPID_PUBLIC_KEY must be the SAME value —
# one is read server-side to sign the push, the other is baked into the
# browser bundle to create the subscription. VAPID_SUBJECT is a contact URI
# the push services can reach, conventionally mailto:someone@example.com.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT="mailto:you@example.com"
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- File storage (apps/api/src/storage) ---
# Where uploaded photos and documents live. Two backends:
#
#   local-db  (default) — bytes are base64'd into the owning row's Text
#               column. Needs no infrastructure, which is why it is the
#               default: a fresh clone runs with nothing but Postgres.
#   s3        — one object per file in the bucket below; the row keeps only
#               the key. The browser uploads straight to S3 through a
#               presigned PUT, and reads come back as presigned GETs, so the
#               bucket must NOT be publicly readable.
#
# Setting FILE_STORAGE_PROVIDER=s3 makes all four AWS_* vars required — the
# app refuses to boot with a half-configured bucket rather than failing at
# the first upload in front of a user.
#
# Bucket setup for s3:
#   - Block Public Access: ON (reads are signed, never public)
#   - CORS: allow PUT from your web origin, ExposeHeaders: ["ETag"]
#   - IAM policy scoped to s3:PutObject/GetObject/DeleteObject on
#     arn:aws:s3:::<bucket>/* and nothing else
#
# Existing inline rows keep working after the switch — see
# apps/api/prisma/backfill-storage.ts to move them across.
FILE_STORAGE_PROVIDER="local-db"
# AWS_REGION="ap-southeast-1"
# AWS_S3_BUCKET=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# How long signed URLs stay valid, in seconds. Defaults: 900 for reads (long
# enough to outlive a page session), 300 for uploads (used immediately).
# S3_SIGNED_GET_TTL_SECONDS="900"
# S3_SIGNED_PUT_TTL_SECONDS="300"
