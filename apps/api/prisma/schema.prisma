// Toastly Postgres schema — the tenancy shape everything else sits on.
//
// One `Club` row per tenant, with denormalised lineage (areaId/divisionId/
// districtId) so scope resolution never runs a recursive CTE. One
// `Membership` row per (User, Club); `userId` is nullable so a Club Admin
// can pre-populate the roster before a person signs up. Composite tenant
// FKs (via `@@unique([clubId, id])`) make cross-tenant references
// physically impossible on the high-risk operational tables added in
// S9–S12.
//
// Prisma enum values are string-identical to `@toastly/access` unions so a
// rename is a build error, not a runtime 403 — the compile-time assertion
// lives in `apps/api/src/access/roles.compat.ts`.

generator client {
  provider      = "prisma-client-js"
  // The query engine is a native binary picked per platform. CI builds the
  // deploy bundle on ubuntu-latest and ships it to an Ubuntu VPS, so the
  // Debian/OpenSSL 3 engine must be generated alongside the local one —
  // "native" alone would bake in the build machine's engine and fail to load
  // if the runner image and the VPS ever diverge.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon's pooled endpoint (`-pooler` host) runs PgBouncer in transaction
  // mode, which doesn't guarantee `migrate deploy`'s session-scoped
  // pg_advisory_lock lands on the same backend connection across statements
  // — the lock-wait then times out (P1002) even though the server is
  // reachable. `directUrl` routes migrations at the unpooled endpoint
  // instead; the app keeps using the pooled `url` above.
  directUrl = env("DIRECT_DATABASE_URL")
}

// -------------------------------------------------------------- enums --

enum UserStatus {
  active
  suspended
}

enum ClubDirectoryStatus {
  active
  low
  suspended
}

enum ClubLifecycle {
  active
  inactive
  chartered
}

enum ClubJoinPolicy {
  request
  closed
  open
}

enum MembershipStatus {
  active
  removed
}

/// Whether a person is new to Toastmasters International or already held
/// membership elsewhere before this club placement. Captured once, at
/// provisioning time — nullable because most existing rows predate this
/// field and not every `Membership` traces back through a flow that asks.
enum MemberType {
  new
  existing
}

/// Matches `CLUB_ROLES` in `@toastly/access` exactly.
enum ClubRole {
  ClubAdmin
  Guest
  IPP
  Member
  President
  Secretary
  SergeantAtArms
  Treasurer
  VPEducation
  VPMembership
  VPPR
}

/// Matches `ORG_ROLES` in `@toastly/access` exactly.
enum OrgRole {
  AreaDirector
  DivisionDirector
  DistrictDirector
}

/// Matches `ORG_UNIT_TYPES` in `@toastly/access` exactly.
enum OrgUnitType {
  area
  division
  district
}

enum InviteStatus {
  pending
  accepted
  revoked
  expired
}

enum JoinRequestStatus {
  pending
  approved
  declined
  withdrawn
}

enum MeetingStatus {
  draft
  published
}

/// The 6 shapes of `HistoryEvent` in `lib/education/history.ts`. Kebab-case
/// on the wire (`level-reached`, `speech-given`, …) — the serializer maps
/// between the two.
enum HistoryEventType {
  joined
  levelReached
  speechGiven
  projectStarted
  projectCompleted
  roleTaken
}

enum SpeechSlotRequestStatus {
  pending
  approved
  declined
}

/// Lifecycle of a Library › Planner idea, read as a progression:
/// fresh → in progress → shipped. String-identical to the `IdeaStatus`
/// union in `components/library/planner-day-panel.tsx`.
enum PlannerIdeaStatus {
  created
  drafted
  published
}

// -------------------------------------------------------- identity --

model User {
  id                 String     @id @default(cuid())
  /// Primary auth credential — every user signs in with phone + password.
  /// Stored verbatim from the register form; if we ever need to
  /// canonicalise (E.164), do it in a follow-up migration with a
  /// backfill, not silently on read.
  phone              String     @unique
  /// Optional contact channel — nullable so a user can sign up with
  /// phone alone. Kept CITEXT (raw-SQL migration) + `@unique` so any
  /// email that IS present is still unique, case-insensitively.
  email              String?    @unique
  passwordHash       String
  firstName          String
  lastName           String
  status             UserStatus @default(active)
  /// Checked first on every permission decision — a join for a singleton
  /// bypass is waste, so this stays denormalised.
  isSuperAdmin       Boolean    @default(false)
  emailVerifiedAt    DateTime?
  /// Toastmasters International member number. A person-level identifier
  /// captured once on the account (typically at Super Admin provisioning),
  /// not per club — TI issues one number per member regardless of how many
  /// clubs they belong to.
  tiMemberNumber     String?
  /// Set whenever someone other than the account holder chose the current
  /// password (account creation, admin-driven reset) — cleared the moment
  /// the user successfully changes it themselves via `POST /auth/password`.
  /// Drives the post-login "set your own password" prompt; it's a nudge,
  /// not an enforced gate, so the rest of the app stays reachable either way.
  mustChangePassword Boolean    @default(false)
  /// Short public-facing paragraph — self-service, edited from the profile
  /// page. Same shape as `Prospect.bio`.
  bio                String?    @db.Text
  /// Data-URL or absolute image URL, same convention as `Prospect.avatarUrl`
  /// — no upload service exists, so this is a client-side base64 encode.
  avatarUrl          String?    @db.Text
  /// `ProfileSocial[]` — a small array (0–12 items) embedded rather than a
  /// join table, same trade-off as `Prospect.socials`.
  socials            Json       @default("[]")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  memberships       Membership[]
  orgAssignments    OrgAssignment[]
  refreshTokens     RefreshToken[]
  invitesSent       Invite[]           @relation("InviteInvitedBy")
  joinRequests      JoinRequest[]
  credentialShare   CredentialShare?
  pushSubscriptions PushSubscription[]
}

/// A one-time, unauthenticated handoff of a freshly-created account's
/// credentials — what the Super Admin's "direct link" / QR code point at.
/// Deliberately its own table rather than columns on `User`: it holds a
/// plaintext password, which is a meaningfully different sensitivity level
/// than the rest of the profile, so it should be trivial to reason about
/// and to wipe. There is no expiry column — the row is deleted the moment
/// the recipient's first successful login consumes it (see `AuthService.login`);
/// until then it lives indefinitely, since an admin may create a batch of
/// accounts and send the links out later.
model CredentialShare {
  id        String   @id @default(cuid())
  userId    String   @unique
  token     String   @unique
  firstName String
  lastName  String
  phone     String
  password  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Refresh tokens are hashed (`sha256`) — the raw value the client holds is
/// never persisted. `familyId` groups a rotation lineage: replaying a used
/// token revokes the whole family, catching a stolen refresh token.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([familyId])
}

/// One row per browser/device Web Push subscription — a user signed in on
/// two devices holds two rows. `endpoint` is the push service URL the
/// browser generated (unique per registration, so it doubles as the natural
/// key for upsert-on-resubscribe); `p256dh`/`auth` are the encryption keys
/// `web-push` needs to encrypt the payload for that endpoint. No
/// `expiresAt` — subscriptions don't expire on a schedule, they die when the
/// browser revokes them, which surfaces as a 404/410 from the push service
/// on send (the pipeline should delete the row then, not before).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// -------------------------------------------------------- org tree --

model District {
  id        String   @id @default(cuid())
  name      String
  /// Short designator (e.g. "D88"). Toastmasters districts are commonly
  /// referred to by code rather than full name; nullable so a newly created
  /// district row can be filled in later without blocking.
  code      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  divisions      Division[]
  orgAssignments OrgAssignment[]
}

model Division {
  id         String   @id @default(cuid())
  districtId String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  district       District        @relation(fields: [districtId], references: [id], onDelete: Restrict)
  areas          Area[]
  orgAssignments OrgAssignment[]

  @@index([districtId])
}

model Area {
  id         String   @id @default(cuid())
  divisionId String
  /// Denormalised parent-of-parent so a lookup by district doesn't need to
  /// hop through Division. Rewritten inside the reparent transaction.
  districtId String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  division       Division        @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  clubs          Club[]
  orgAssignments OrgAssignment[]

  @@index([divisionId])
  @@index([districtId])
}

// -------------------------------------------------------- tenant --

model Club {
  id              String              @id @default(cuid())
  /// Nullable: a self-registered club exists before a director places it in
  /// the org tree. Once placed all three fields (`areaId`, `divisionId`,
  /// `districtId`) are set together inside the reparent transaction.
  areaId          String?
  /// Denormalised lineage — scope resolution runs on every request,
  /// reparenting runs approximately never. Only `area` is a real FK; the
  /// other two are plain indexed columns kept in sync by the move
  /// transaction so a Division/District Director's scope filter is one
  /// indexed scan.
  divisionId      String?
  districtId      String?
  name            String
  /// URL-safe identifier for the public directory (`/clubs/<slug>`).
  slug            String              @unique
  clubNumber      String?             @unique
  /// Short, out-of-band join credential — a Club Admin reads this off their
  /// own dashboard and hands it to someone directly (text, verbally, etc.).
  /// Deliberately separate from `slug`: the slug is public (it's in the
  /// directory URL), this is not. Pasting it onto `/clubs/join-by-code`
  /// creates an active `Member` membership immediately, no approval step.
  joinCode        String              @unique
  directoryStatus ClubDirectoryStatus @default(active)
  lifecycle       ClubLifecycle       @default(active)
  joinPolicy      ClubJoinPolicy      @default(request)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  area Area? @relation(fields: [areaId], references: [id], onDelete: SetNull)

  memberships      Membership[]
  invites          Invite[]
  joinRequests     JoinRequest[]
  meetings         Meeting[]
  plannerRows      PlannerRow[]
  prospects        Prospect[]
  assets           Asset[]
  libraryDocuments LibraryDocument[]
  plannerIdeas     PlannerIdea[]
  inventoryItems   InventoryItem[]
  transactions     Transaction[]
  budgetLines      BudgetLine[]
  activityLogs     ActivityLog[]

  @@index([areaId])
  @@index([divisionId])
  @@index([districtId])
  @@index([directoryStatus])
}

model Membership {
  id               String           @id @default(cuid())
  clubId           String
  /// Null until claimed. Postgres treats NULLs as distinct in a UNIQUE
  /// constraint, so `@@unique([clubId, userId])` allows unlimited
  /// unclaimed rows AND one claimed row per user per club.
  userId           String?
  /// Name is denormalised on the membership: the club owns its roster
  /// display, `Robert` vs `Bob` can diverge legitimately, and the roster
  /// keeps working with zero joins on `User`.
  firstName        String
  lastName         String
  email            String?
  roles            ClubRole[]
  isClubAdmin      Boolean          @default(false)
  status           MembershipStatus @default(active)
  /// New TI member vs. someone who already held membership elsewhere before
  /// this club placement. Only ever set by the Super Admin direct-provision
  /// flow today — nullable everywhere else.
  memberType       MemberType?
  /// Sparse per-`resource:action` overrides on top of role grants:
  /// `{ "transaction:delete": "deny" }`. Read on every request alongside
  /// the row; not a join table because 0–10 keys per row × 2,500 rows fits
  /// in JSON without any join hot path.
  grantOverrides   Json             @default("{}")
  /// Toastmasters education profile. Deferred: a `UserEducationProfile`
  /// following the user between clubs is purely additive.
  pathway          String?
  level            Int?
  startingLevel    Int?
  startedProject   String?
  pathwayStartedAt DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  club Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  invitesCreated         Invite[]                @relation("InvitePreCreatedMembership")
  decidedJoinRequests    JoinRequest[]
  historyEvents          HistoryEvent[]
  evaluationsReceived    Evaluation[]            @relation("EvaluationSpeaker")
  evaluationsGiven       Evaluation[]            @relation("EvaluationEvaluator")
  timerEntries           TimerEntry[]
  ahCounterEntries       AhCounterEntry[]
  speechSlotRequests     SpeechSlotRequest[]
  duesRecords            DuesRecord[]
  tasksCreated           Task[]                  @relation("TaskCreatedBy")
  tasksCompleted         Task[]                  @relation("TaskDoneBy")
  taskAssignments        TaskAssignee[]
  taskNotes              TaskNote[]
  meetingRoleAssignments MeetingRoleAssignment[]
  meetingAttendance      MeetingAttendance[]
  speakerSlots           MeetingSpeaker[]        @relation("MeetingSpeakerAsSpeaker")
  evaluatorSlots         MeetingSpeaker[]        @relation("MeetingSpeakerAsEvaluator")

  @@unique([clubId, userId])
  /// Enables composite tenant FKs on operational tables: any child row
  /// pointing at a Membership must reference `(clubId, membershipId)` so a
  /// cross-tenant reference is a schema error, not a bug caught in review.
  @@unique([clubId, id])
  @@index([clubId, status])
  @@index([userId])
  @@index([email])
}

model OrgAssignment {
  id           String      @id @default(cuid())
  userId       String
  role         OrgRole
  unitType     OrgUnitType
  /// Exactly one of these is set for a given assignment, matching
  /// `unitType`. Typed FKs — polymorphic pointers would be a bug factory.
  areaId       String?
  divisionId   String?
  districtId   String?
  termStartsOn DateTime?
  termEndsOn   DateTime?
  createdAt    DateTime    @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  area     Area?     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  division Division? @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  district District? @relation(fields: [districtId], references: [id], onDelete: Cascade)

  @@unique([userId, role, unitType, areaId, divisionId, districtId])
  @@index([userId])
  @@index([areaId])
  @@index([divisionId])
  @@index([districtId])
}

// -------------------------------------------------------- onboarding --

model Invite {
  id              String       @id @default(cuid())
  clubId          String
  /// Left null by the link-based invite flow (an admin picks role(s), not a
  /// specific person). Only ever set by legacy rows created before that
  /// flow existed.
  email           String?
  firstName       String?
  lastName        String?
  /// Free-text label the admin types in when generating the link — who they
  /// expect to use it, for their own tracking. Not tied to the actual
  /// accepter's identity, which the link doesn't know until claimed.
  inviteeName     String?
  roles           ClubRole[]
  status          InviteStatus @default(pending)
  /// Plaintext — unlike a password, this token has to be redisplayed to the
  /// admin later (the pending-invites list re-shares the same link), which
  /// a one-way hash can't support. Same tradeoff as `CredentialShare.token`.
  token           String       @unique
  membershipId    String?      @unique
  invitedByUserId String
  expiresAt       DateTime
  createdAt       DateTime     @default(now())
  acceptedAt      DateTime?
  revokedAt       DateTime?

  club          Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  invitedBy     User        @relation("InviteInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  preMembership Membership? @relation("InvitePreCreatedMembership", fields: [membershipId], references: [id], onDelete: SetNull)
  /// The partial index `invite_one_pending_per_club_email` is added by a
  /// raw-SQL migration — Prisma cannot express a `WHERE status = 'pending'`
  /// clause on a UNIQUE index. `lower(email)` treats every NULL as distinct,
  /// so link invites (no email) never collide on it.

  @@index([clubId, status])
  @@index([email])
}

model JoinRequest {
  id                    String            @id @default(cuid())
  clubId                String
  userId                String
  message               String?
  status                JoinRequestStatus @default(pending)
  decidedByMembershipId String?
  decidedAt             DateTime?
  createdAt             DateTime          @default(now())

  club      Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  decidedBy Membership? @relation(fields: [decidedByMembershipId], references: [id], onDelete: SetNull)
  /// The partial index `joinreq_one_pending_per_club_user` is added by a
  /// raw-SQL migration for the same reason as `Invite`'s — Prisma can't
  /// express `WHERE status = 'pending'` on a UNIQUE index.

  @@index([clubId, status])
  @@index([userId])
}

// -------------------------------------------------------- meetings --

model Meeting {
  id               String        @id @default(cuid())
  clubId           String
  meetingNumber    Int
  dateTime         DateTime
  theme            String
  status           MeetingStatus @default(draft)
  /// The grammarian's word of the day, set on the meeting's Theme tab.
  /// Four nullable columns rather than one Json blob: the shape is fixed,
  /// and the agenda renders each part on its own line. All four are null
  /// until someone fills the tab in.
  word             String?
  wordPartOfSpeech String?
  wordMeaning      String?       @db.Text
  wordExample      String?       @db.Text
  /// Opaque share credential — the link IS the capability. Rotates on
  /// demand so a leaked URL can be revoked without breaking the meeting
  /// itself. Unique globally so `/public/meetings/:id?t=<token>` can look
  /// up (id, token) without a tenant filter.
  shareToken       String        @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  club                Club                     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  visitLogs           VisitLog[]
  checklistItems      ChecklistItem[]          @relation("MeetingChecklist")
  roleAssignments     MeetingRoleAssignment[]  @relation("MeetingRoles")
  speakers            MeetingSpeaker[]         @relation("MeetingSpeakers")
  tableTopicQuestions TableTopicQuestion[]     @relation("MeetingTableTopics")
  attendanceRecords   MeetingAttendance[]      @relation("MeetingAttendance")
  guestAttendance     MeetingGuestAttendance[] @relation("MeetingGuestAttendance")
  plannerRows         PlannerRow[]

  @@unique([clubId, id])
  @@unique([clubId, meetingNumber])
  @@index([clubId, dateTime])
}

/// One row per (meeting, role key) — who's assigned to President, Toastmaster,
/// Ah Counter, etc. `roleKey` matches `RoleDef.key` in the web's
/// `lib/meetings/roles.ts`; kept as a plain string rather than an enum since
/// that list is presentation-owned and can grow without a migration.
/// `membershipId`/`guestId` are both nullable so a role can be created "open"
/// and filled in later — the row itself is only created once someone touches
/// the picker. At most one of the two is ever set; enforced in
/// `MeetingRolesService`, not the schema.
model MeetingRoleAssignment {
  id           String   @id @default(cuid())
  clubId       String
  meetingId    String
  roleKey      String
  membershipId String?
  guestId      String?
  updatedAt    DateTime @default(now()) @updatedAt

  meeting    Meeting     @relation("MeetingRoles", fields: [clubId, meetingId], references: [clubId, id], onDelete: Cascade)
  membership Membership? @relation(fields: [clubId, membershipId], references: [clubId, id], onDelete: SetNull)
  guest      Prospect?   @relation(fields: [clubId, guestId], references: [clubId, id], onDelete: SetNull)

  @@unique([clubId, meetingId, roleKey])
  @@index([clubId, meetingId])
  @@index([clubId, guestId])
}

/// One row per prepared speech slot on a meeting (`order` 1–3, matching the
/// planner's Speaker 1–3 columns). Unlike `MeetingRoleAssignment` this used to
/// live only in browser memory (the Prepared Speakers tab's Redux draft) —
/// promoted to a real table so it survives a refresh and can mirror with the
/// planner row the same way roles do. Speaker and evaluator each resolve to
/// a member OR a guest, never both — enforced in `PreparedSpeakersService`.
model MeetingSpeaker {
  id                    String   @id @default(cuid())
  clubId                String
  meetingId             String
  order                 Int
  status                String   @default("requested")
  membershipId          String?
  guestId               String?
  evaluatorMembershipId String?
  evaluatorGuestId      String?
  title                 String   @default("")
  duration              Int?
  pathway               String?
  project               String?
  notes                 String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  meeting             Meeting     @relation("MeetingSpeakers", fields: [clubId, meetingId], references: [clubId, id], onDelete: Cascade)
  membership          Membership? @relation("MeetingSpeakerAsSpeaker", fields: [clubId, membershipId], references: [clubId, id], onDelete: SetNull)
  guest               Prospect?   @relation("MeetingSpeakerGuestAsSpeaker", fields: [clubId, guestId], references: [clubId, id], onDelete: SetNull)
  evaluatorMembership Membership? @relation("MeetingSpeakerAsEvaluator", fields: [clubId, evaluatorMembershipId], references: [clubId, id], onDelete: SetNull)
  evaluatorGuest      Prospect?   @relation("MeetingSpeakerGuestAsEvaluator", fields: [clubId, evaluatorGuestId], references: [clubId, id], onDelete: SetNull)

  @@unique([clubId, meetingId, order])
  @@index([clubId, meetingId])
}

/// One Table Topics question, in ask order (`createdAt`). Meeting-scoped like
/// `ChecklistItem` — capped at 10 by the Table Topics tab, not enforced here.
model TableTopicQuestion {
  id        String    @id @default(cuid())
  clubId    String
  meetingId String
  text      String    @db.Text
  asked     Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime?

  meeting Meeting @relation("MeetingTableTopics", fields: [clubId, meetingId], references: [clubId, id], onDelete: Cascade)

  @@index([clubId, meetingId])
}

/// Club-roster check-in for one meeting. A row only exists once a member has
/// been toggled at least once — absence means "not yet marked present",
/// matching the local-state behaviour the Attendance tab replaces.
model MeetingAttendance {
  id           String   @id @default(cuid())
  clubId       String
  meetingId    String
  membershipId String
  present      Boolean  @default(false)
  updatedAt    DateTime @default(now()) @updatedAt

  meeting    Meeting    @relation("MeetingAttendance", fields: [clubId, meetingId], references: [clubId, id], onDelete: Cascade)
  membership Membership @relation(fields: [clubId, membershipId], references: [clubId, id], onDelete: Cascade)

  @@unique([clubId, meetingId, membershipId])
  @@index([clubId, meetingId])
}

/// A meeting-day attendee, always linked back to a `Prospect` (guest-pipeline
/// record) — `/people` is the only place a guest gets created, so checking
/// someone in here always resolves to an existing guest. `guestId` is nullable
/// only so older free-text rows (created before this link existed) keep
/// loading; every row created going forward has one. `name` stays a snapshot
/// of the guest's name at check-in time rather than a live join, matching how
/// `VisitLog.role`/`notes` are also point-in-time snapshots.
model MeetingGuestAttendance {
  id        String    @id @default(cuid())
  clubId    String
  meetingId String
  guestId   String?
  name      String
  present   Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime?

  meeting Meeting   @relation("MeetingGuestAttendance", fields: [clubId, meetingId], references: [clubId, id], onDelete: Cascade)
  guest   Prospect? @relation(fields: [clubId, guestId], references: [clubId, id], onDelete: SetNull)

  @@unique([clubId, meetingId, guestId])
  @@index([clubId, meetingId])
  @@index([clubId, guestId])
}

/// One row on the Education › Planner grid — a meeting being roughed out
/// before it's created for real. `meetingNumber`/`dateTime` are typed in by
/// hand and stay nullable (the row can exist long before either is known);
/// `assignees` is `Record<AssigneeField, Assignee | null>` (see the web's
/// `lib/education/planner.ts`) stored as one JSON blob rather than 13
/// columns — the shape is presentation-owned and always read as a whole.
/// `meetingId` is set once "Create meeting" succeeds; it's the join the grid
/// uses to shade a row green, replacing a fragile meetingNumber-matching
/// heuristic.
model PlannerRow {
  id            String    @id @default(cuid())
  clubId        String
  meetingNumber Int?
  /// Raw `datetime-local` string ("YYYY-MM-DDTHH:mm") — same free-text
  /// storage as the grid's own input, not a `DateTime` column, so a
  /// half-filled date doesn't need a sentinel value.
  dateTime      String?
  theme         String    @default("")
  notes         String    @default("") @db.Text
  assignees     Json      @default("{}")
  meetingId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime?

  club    Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  meeting Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([clubId, createdAt])
  @@index([meetingId])
}

// ------------------------------------------------------- education --

/// Wide single-table encoding of the 6-variant discriminated union in
/// `lib/education/history.ts`. Nullable columns hold the variant-specific
/// fields; validated at the DTO layer, not the DB.
model HistoryEvent {
  id            String           @id @default(cuid())
  clubId        String
  membershipId  String
  type          HistoryEventType
  /// Stored as a full timestamp; the wire projects to the `YYYY-MM-DD`
  /// prefix, matching the existing frontend expectation.
  date          DateTime
  meetingNumber Int?
  /// Meeting role label — one of `MEETING_ROLES` in `lib/education/history.ts`
  /// (e.g. "Toastmaster of the Day"). Nullable — only set for `roleTaken`.
  role          String?
  /// Speech title for `speechGiven`.
  title         String?
  /// Project name for `speechGiven`/`projectStarted`/`projectCompleted`.
  projectName   String?
  /// Level (1–5) for `levelReached`/`projectStarted`/`projectCompleted`.
  level         Int?
  /// Pathway name (one of `PATHWAYS`) for `levelReached`/`projectStarted`/`projectCompleted`.
  pathway       String?
  createdAt     DateTime         @default(now())

  membership Membership @relation(fields: [clubId, membershipId], references: [clubId, id], onDelete: Cascade)

  @@index([clubId, membershipId])
  @@index([clubId, date])
}

/// Peer evaluation of a prepared speech, one per `speech-given` event.
/// `speechEventId` is a soft reference — history rows are recreated on
/// re-seed, so a hard FK would tangle the seed flow; the client joins the
/// two on the wire.
model Evaluation {
  id                    String   @id @default(cuid())
  clubId                String
  membershipId          String
  evaluatorMembershipId String
  speechEventId         String
  meetingNumber         Int
  date                  DateTime
  strengths             String
  improvement           String
  overallRating         Int
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  membership Membership @relation("EvaluationSpeaker", fields: [clubId, membershipId], references: [clubId, id], onDelete: Cascade)
  evaluator  Membership @relation("EvaluationEvaluator", fields: [clubId, evaluatorMembershipId], references: [clubId, id], onDelete: Cascade)

  @@index([clubId, membershipId])
  @@index([speechEventId])
}

model TimerEntry {
  id               String   @id @default(cuid())
  clubId           String
  membershipId     String
  speechEventId    String
  meetingNumber    Int
  date             DateTime
  targetMinMinutes Int
  targetMaxMinutes Int
  actualSeconds    Int
  createdAt        DateTime @default(now())

  membership Membership @relation(fields: [clubId, membershipId], references: [clubId, id], onDelete: Cascade)

  @@index([clubId, membershipId])
  @@index([speechEventId])
}

model AhCounterEntry {
  id            String   @id @default(cuid())
  clubId        String
  membershipId  String
  speechEventId String
  meetingNumber Int
  date          DateTime
  /// `{ ah: 4, um: 2, so: 1, like: 0 }` — a small key/value bag whose keys
  /// vary by club convention. JSON is the right shape; a join table would
  /// carry a hot-path query for a rarely-mutated map.
  fillerCounts  Json     @default("{}")
  createdAt     DateTime @default(now())

  membership Membership @relation(fields: [clubId, membershipId], references: [clubId, id], onDelete: Cascade)

  @@index([clubId, membershipId])
  @@index([speechEventId])
}

model SpeechSlotRequest {
  id           String                  @id @default(cuid())
  clubId       String
  membershipId String
  meetingId    String
  projectName  String?
  note         String?
  status       SpeechSlotRequestStatus @default(pending)
  requestedAt  DateTime                @default(now())

  membership Membership @relation(fields: [clubId, membershipId], references: [clubId, id], onDelete: Cascade)

  @@index([clubId, membershipId])
  @@index([clubId, meetingId])
}

// --------------------------------------------------------- people --

/// The guest-pipeline entity. Named `Prospect` on the DB to sidestep the
/// clash with the `ClubRole.Guest` enum value; the API path stays `/guests`
/// and every UI string still reads "Guest" — the rename is DB-only.
model Prospect {
  id         String    @id @default(cuid())
  clubId     String
  firstName  String
  lastName   String
  email      String?
  phone      String?
  whatsapp   String?
  avatarUrl  String?   @db.Text
  /// `GuestSocial[]` — a small array (0–8 items) embedded rather than
  /// carried in a separate table. Read on every profile render.
  socials    Json      @default("[]")
  bio        String?
  notes      String?
  firstVisit DateTime?
  lastVisit  DateTime?
  visitCount Int       @default(0)
  invitedBy  String?
  /// One of `GUEST_STAGE_IDS` (`new` / `contacted` / `interested` /
  /// `joined-meetings` / `joined-club` / `not-interested`). Stored as a
  /// plain string because Prisma enum identifiers cannot contain hyphens;
  /// the DTO enforces the union.
  stage      String    @default("new")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  club        Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  contactLogs ContactLog[]
  visitLogs   VisitLog[]

  roleAssignments   MeetingRoleAssignment[]
  speakerSlots      MeetingSpeaker[]         @relation("MeetingSpeakerGuestAsSpeaker")
  evaluatorSlots    MeetingSpeaker[]         @relation("MeetingSpeakerGuestAsEvaluator")
  meetingAttendance MeetingGuestAttendance[]

  @@unique([clubId, id])
  @@index([clubId, stage])
}

model ContactLog {
  id         String    @id @default(cuid())
  clubId     String
  prospectId String
  /// One of `CONTACT_METHOD_IDS`. `in-person` carries a hyphen, so the
  /// column stays a plain string (same trade-off as `Prospect.stage`).
  method     String
  outcome    String    @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime?

  prospect Prospect @relation(fields: [clubId, prospectId], references: [clubId, id], onDelete: Cascade)

  @@index([clubId, prospectId])
}

model VisitLog {
  id         String    @id @default(cuid())
  clubId     String
  prospectId String
  /// SetNull on meeting delete — the drawer falls back to a "meeting no
  /// longer on file" line, matching the local-db behaviour.
  meetingId  String?
  role       String?
  notes      String?   @db.Text
  /// `meeting` when auto-created from a meeting agenda naming this guest,
  /// `manual` when added by hand.
  origin     String    @default("manual")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime?

  prospect Prospect @relation(fields: [clubId, prospectId], references: [clubId, id], onDelete: Cascade)
  meeting  Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([clubId, prospectId])
  @@index([meetingId])
}

// -------------------------------------------------------- library --

/// A single image the club keeps in its shared asset library — flyer, meeting
/// photo, poster template. Bytes are inlined as a data-URL on the local-db
/// backend and stay inline here until an object-store backend arrives; the
/// column is plain `Text` for that reason (Postgres handles a few MB fine).
model Asset {
  id        String    @id @default(cuid())
  clubId    String
  title     String
  imageUrl  String    @db.Text
  mimeType  String
  width     Int
  height    Int
  sizeBytes Int
  createdAt DateTime  @default(now())
  updatedAt DateTime?

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId, createdAt])
}

/// A non-image file the club keeps on the shared shelf — minutes, agendas,
/// spreadsheets, handbooks. Same inline-bytes strategy as `Asset`.
model LibraryDocument {
  id        String    @id @default(cuid())
  clubId    String
  title     String
  fileName  String
  fileUrl   String    @db.Text
  mimeType  String
  sizeBytes Int
  createdAt DateTime  @default(now())
  updatedAt DateTime?

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId, createdAt])
}

/// One idea pinned to one calendar day on the Library › Planner board.
///
/// `day` is date-only and stored as `String` for the same reason as
/// `Transaction.date`: the planner is a calendar surface, and giving the
/// column timezone semantics would make "which cell does this land in"
/// depend on the reader's offset. The month query is a plain string range
/// (`gte`/`lte`) against the yyyy-mm-dd form, which sorts lexicographically.
model PlannerIdea {
  id          String            @id @default(cuid())
  clubId      String
  /// yyyy-mm-dd — the day cell this idea belongs to.
  day         String
  title       String
  body        String            @db.Text
  /// `[{ uid, name }]`. Filenames only: the planner form holds attachments
  /// client-side (`beforeUpload` returns `false`, so antd never posts the
  /// bytes anywhere), and only the names were ever part of an idea. When a
  /// real upload flow lands these become `LibraryDocument` references.
  attachments Json              @default("[]")
  status      PlannerIdeaStatus @default(created)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime?

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId, day])
}

// ------------------------------------------------------- inventory --

/// A physical asset the club owns — banner, timing lights, gavel. Tracked
/// separately from `Asset` (digital files) because ownership, not
/// distribution, is what the Inventory tab is about.
model InventoryItem {
  id            String    @id @default(cuid())
  clubId        String
  title         String
  description   String?   @db.Text
  imageUrl      String?   @db.Text
  imageMimeType String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime?

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId, createdAt])
}

/// A single line on a meeting's pre-meeting checklist. Meeting-scoped so the
/// Meeting tab and the Inventory tab read the same rows for the current
/// meeting — ticking off from either surface updates the other. Composite FK
/// against `Meeting.(clubId, id)` so a checklist item cannot straddle clubs.
model ChecklistItem {
  id        String    @id @default(cuid())
  clubId    String
  meetingId String
  text      String
  done      Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime?

  meeting Meeting @relation("MeetingChecklist", fields: [clubId, meetingId], references: [clubId, id], onDelete: Cascade)

  @@index([clubId, meetingId])
}

// --------------------------------------------------------- finance --

/// The club's ledger — every taka in or out. Running balances are computed
/// on the fly from this table, never stored, so they can never drift out of
/// sync with an edited or deleted row.
///
/// `duesRecordId` is set only on the income row auto-created when a dues
/// payment is recorded; the pair (record ↔ transaction) is maintained by
/// `updateDuesRecord` inside a `$transaction`. Direct edits to a
/// dues-linked row return 409 `TRANSACTION_LOCKED_TO_DUES`.
model Transaction {
  id           String    @id @default(cuid())
  clubId       String
  /// yyyy-mm-dd — the date the money actually moved. Stored as `String`
  /// (not `DateTime`) because the ledger is a date-only surface and adding
  /// timezone semantics would make the sort/group logic on the client
  /// harder for zero gain.
  date         String
  direction    String
  category     String
  amountMinor  Int
  description  String
  method       String
  counterparty String?
  reference    String?
  duesRecordId String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime?

  club       Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  duesRecord DuesRecord? @relation(fields: [duesRecordId], references: [id], onDelete: SetNull)

  @@index([clubId, date])
  @@index([clubId, category])
}

/// One row per (member, dues period). Status is always derived from the
/// amounts, never stored, so it can never drift out of sync with a payment.
/// `DuesPeriod` is a fixed calendar constant (Toastmasters renewals fall on
/// 1 Oct / 1 Apr) and lives in the web module — no table for that.
///
/// Composite FK against `Membership.(clubId, id)` keeps a record's member and
/// club aligned at the schema level.
model DuesRecord {
  id              String    @id @default(cuid())
  clubId          String
  /// One of `DUES_PERIODS` in `lib/finance/dues.ts`. Plain string because
  /// values are compound like `2026-apr`.
  periodId        String
  membershipId    String
  amountDueMinor  Int
  amountPaidMinor Int       @default(0)
  waived          Boolean   @default(false)
  paidOn          String?
  method          String?
  note            String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime?

  membership  Membership   @relation(fields: [clubId, membershipId], references: [clubId, id], onDelete: Cascade)
  transaction Transaction?

  @@unique([clubId, periodId, membershipId])
  @@index([clubId, periodId])
}

/// Treasurer's annual plan — how much each category is expected to bring in
/// or cost across a fiscal year. Actuals are computed on the fly from the
/// ledger, never stored.
model BudgetLine {
  id           String    @id @default(cuid())
  clubId       String
  fiscalYear   String
  kind         String
  category     String
  plannedMinor Int
  note         String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime?

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, fiscalYear, category])
  @@index([clubId, fiscalYear])
}

// -------------------------------------------------------- tasks --

enum TaskPriority {
  Low
  Medium
  High
}

/// A club officer action item, optionally assigned to one or more members
/// (`TaskAssignee`). Distinct from `ChecklistItem` (meeting-scoped SAA
/// prep). Composite FKs against `Membership.(clubId, id)` throughout —
/// every relation here is club-scoped.
model Task {
  id                    String       @id @default(cuid())
  clubId                String
  title                 String
  description           String?
  priority              TaskPriority @default(Medium)
  dueDate               String?
  done                  Boolean      @default(false)
  /// Set together with `done`; whichever assignee closed it out. Multiple
  /// people can be assigned, but the task is completed once, by one of them.
  doneByMembershipId    String?
  doneAt                DateTime?
  createdByMembershipId String
  createdAt             DateTime     @default(now())
  updatedAt             DateTime?

  createdBy Membership     @relation("TaskCreatedBy", fields: [clubId, createdByMembershipId], references: [clubId, id], onDelete: Cascade)
  doneBy    Membership?    @relation("TaskDoneBy", fields: [clubId, doneByMembershipId], references: [clubId, id], onDelete: SetNull)
  assignees TaskAssignee[]
  notes     TaskNote[]

  @@index([clubId])
  @@index([clubId, createdByMembershipId])
  @@index([clubId, doneByMembershipId])
}

/// Pivot: which members a task is assigned to. `clubId` is denormalised
/// (rather than joined through `Task`) so the FK into `Membership` can use
/// the tenant-safe composite `(clubId, id)` pattern every other child table
/// uses.
model TaskAssignee {
  taskId       String
  clubId       String
  membershipId String
  createdAt    DateTime @default(now())

  task       Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [clubId, membershipId], references: [clubId, id], onDelete: Cascade)

  @@id([taskId, membershipId])
  @@index([clubId, membershipId])
}

/// A freeform progress note left by the creator or an assignee — a running
/// log rather than a single overwritable field, so two assignees updating
/// at once don't clobber each other.
model TaskNote {
  id           String   @id @default(cuid())
  taskId       String
  clubId       String
  membershipId String
  body         String
  createdAt    DateTime @default(now())

  task       Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [clubId, membershipId], references: [clubId, id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([clubId, membershipId])
}

// ------------------------------------------------------- activity --

/// "Who did what, when" — the audit stream. Emitted from write paths that
/// mutate a domain the user cares about tracking. `entityType`/`entityId`
/// is a soft polymorphic pointer so rebuilding the referenced entity's
/// row doesn't tangle the log.
///
/// `actorMembershipId` is a **soft reference** to `Membership` — no FK.
/// When a member is removed the log survives with the pointer dangling; the
/// feed renders "Removed member" for that row. A composite tenant FK with
/// `SetNull` doesn't fit (would null the tenant `clubId` too) and `Cascade`
/// would destroy the audit trail on removal, which defeats the point.
///
/// `points` is reserved for a future leaderboard rollup; always 0 today.
model ActivityLog {
  id                String   @id @default(cuid())
  clubId            String
  actorMembershipId String?
  category          String
  action            String
  summary           String
  entityType        String?
  entityId          String?
  points            Int      @default(0)
  createdAt         DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId, createdAt])
  @@index([clubId, category])
  @@index([clubId, actorMembershipId])
}
