# Where this client finds the API. Origin only — the `/api` prefix is added in
# src/lib/config.ts. Expo inlines EXPO_PUBLIC_* at build time.
#
# For `pnpm dev:mobile`, use the machine's LAN address, not localhost: on a
# phone or simulator localhost means the device itself.
#
#   EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
#
# EAS builds do not read this file (it is gitignored). The preview and
# production profiles set the value in eas.json instead.
EXPO_PUBLIC_API_URL=http://localhost:4000
