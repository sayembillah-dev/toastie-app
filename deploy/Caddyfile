# Live on the VPS at /etc/caddy/Caddyfile. Kept here so a change to routing
# (e.g. a new API prefix) is reviewed alongside the code that needs it,
# instead of drifting silently on the box. After editing the real file:
#   sudo caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
#   sudo systemctl reload caddy
#
# Both commands above run as the `deploy` user without a password — a
# sudoers rule on the VPS (/etc/sudoers.d/toastly-caddy) allows exactly those
# two invocations and nothing else.
#
# DNS is Cloudflare-PROXIED (orange cloud), not direct to origin. Caddy still
# auto-provisions and renews the Let's Encrypt certificate, because Cloudflare
# passes the HTTP-01 challenge through to the origin, and still redirects
# HTTP → HTTPS.
#
# Consequence of the proxy: {http.request.remote.host} below is a Cloudflare
# edge IP, so X-Real-IP carries Cloudflare's address, not the client's. The
# real client IP arrives in the CF-Connecting-IP header. If the app ever needs
# accurate client IPs, read that header — and only trust it from Cloudflare's
# published ranges, or anyone hitting the origin directly can forge it.

toastie.niftyitsolution.com {
        encode zstd gzip

        request_body {
                max_size 25MB
        }

        # Nest's global prefix is 'api' (see apps/api/src/main.ts) — this must
        # stay in sync with that, not with whatever the previous app on this
        # box used.
        @api path /api/*
        handle @api {
                reverse_proxy 127.0.0.1:4000 {
                        header_up X-Real-IP {http.request.remote.host}
                }
        }

        handle {
                reverse_proxy 127.0.0.1:3000 {
                        header_up X-Real-IP {http.request.remote.host}
                }
        }
}
